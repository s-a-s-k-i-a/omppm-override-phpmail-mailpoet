<?xml version="1.0"?>
<ruleset name="SMTP Mail Control for MailPoet">
  <description>PHP compatibility baseline. Full WPCS adoption is tracked in GitHub issue #2.</description>

  <file>omppm-override-phpmail-mailpoet.php</file>
  <file>includes</file>
  <file>tests/unit</file>

  <exclude-pattern>vendor/*</exclude-pattern>

  <arg name="basepath" value="."/>
  <arg name="colors"/>
  <arg value="sp"/>
  <arg name="extensions" value="php"/>

  <rule ref="PHPCompatibilityWP">
    <properties>
      <property name="testVersion" value="8.1-"/>
    </properties>
  </rule>

  <config name="minimum_supported_wp_version" value="6.5"/>
  <config name="testVersion" value="8.1-"/>
</ruleset>
